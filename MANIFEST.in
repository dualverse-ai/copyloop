include README.md LICENSE NOTICE.md CITATION.cff requirements-gpu.txt
include .gitignore
include SOURCE_MAP.md SOURCE_MANIFEST.json PACKAGE_SOURCE_MAP.json
recursive-include docs *.md *.json
recursive-include licenses *.md *.txt *.json
recursive-include tests *.py
recursive-include backends *.py *.toml *.md *.yaml .python-version
global-exclude __pycache__ *.py[cod]
prune .validation
prune .venv-package-check
prune build
prune dist
